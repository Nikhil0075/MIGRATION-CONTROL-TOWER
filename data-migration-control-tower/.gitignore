__pycache__/
*.pyc
.env
*.env
.venv/
venv/
*.bak
simulator/source_setup/*.bak
.pytest_cache/
*.egg-info/
gcp-service-account*.json
.terraform/
*.log
frontend/static/firebase-config.js

# --- Local credential overrides -------------------------------------------
# `.env` and `*.env` above miss the conventional per-environment override
# names, which are exactly the files most likely to hold a REAL credential
# (the committed .env.example holds only placeholders). .env.example is
# deliberately still tracked — it is the template a new team copies.
.env.*
!.env.example

# --- Node / frontend build output -----------------------------------------
# The Oracle JET client's dependency tree and release bundle are both
# regenerated by `npm ci && npm run build`; committing them adds tens of
# thousands of files and makes every dependency bump an unreviewable diff.
# package-lock.json IS committed (pinned, reproducible installs).
node_modules/
frontend/client/web/

# Playwright artifacts: traces, screenshots and HTML reports from failed
# runs. The committed *snapshots* under e2e/**-snapshots/ are the baselines
# and must stay tracked.
test-results/
playwright-report/

# Local build proofs from tools/brand_assets.py --check
build/

# Rescue exports written by tools/purge_orphans.py. They contain real
# estate metadata (table and column names) and are local safety copies,
# not artefacts to publish.
var/

# Terraform (Deploy & Harden Phase 2/5). *.tfplan is a binary artifact of
# one specific `terraform plan` run against live state — never meant to
# be reviewed as a diff or replayed elsewhere. terraform.tfvars holds
# this deployment's real values (which services are live,
# service_image_tags); *.tfvars.example documents the shape without
# committing a specific live deployment's state as if it were the
# module's default.
infrastructure/terraform/*.tfplan
infrastructure/terraform/terraform.tfvars

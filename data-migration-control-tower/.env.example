# Copy to .env and fill in. Never commit the real .env file.

# --- GCP ---
GCP_PROJECT_ID=autonomous-data-migration
GCP_REGION=us-central1
FIRESTORE_DATABASE=(default)
BQ_DATASET=migration_target
GOOGLE_APPLICATION_CREDENTIALS=

# --- Gemini / ADK ---
GEMINI_MODEL=gemini-3.5-flash
GOOGLE_GENAI_USE_VERTEXAI=true

# --- Local legacy source (SQL Server / WideWorldImporters) ---
# These remain the single-estate local-dev path. With multiple estates,
# per-source connection detail comes from the estate's connection_profile
# instead (see simulator/source_setup/estate.yaml and tools/secrets.py);
# SQLSERVER_PASSWORD then acts as the declared `password_env` fallback for
# this estate only, used when its password_secret_ref cannot be resolved
# from Secret Manager. A WARNING naming the path is logged whenever that
# fallback fires — it must never pass unnoticed in a deployed environment.
SQLSERVER_HOST=localhost
SQLSERVER_PORT=1433
SQLSERVER_DB=WideWorldImporters
SQLSERVER_USER=sa
SQLSERVER_PASSWORD=ChangeMe_Str0ng!
# Seconds a resolved secret is cached in-process before re-resolution.
# A plain lru_cache would pin a rotated credential for the process's life.
# SECRET_CACHE_TTL_SECONDS=300
# Optional: force a specific ODBC driver name (see `python -c "import
# pyodbc; print(pyodbc.drivers())"`). Auto-detected otherwise, preferring
# ODBC Driver 18 > 17 > the in-box legacy "SQL Server" driver.
# SQLSERVER_ODBC_DRIVER=ODBC Driver 18 for SQL Server

# --- Second estate fixture (PostgreSQL, §32.11 clean-estate onboarding) ---
# Started by: cd simulator/source_setup/postgres && docker compose up -d
# Port 5433, not 5432: a developer machine often already runs Postgres on
# 5432, and a fixture that silently connects to someone's real database is
# a worse failure than one that refuses to start.
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=postgres
POSTGRES_PASSWORD=ChangeMe_Str0ng!
POSTGRES_DB=retaildb

# --- Oracle-dialect corpus (static files, no live Oracle instance) ---
ORACLE_CORPUS_PATH=simulator/source_setup/oracle_dialect_corpus
DAG_ARTIFACTS_PATH=simulator/source_setup/dags

# --- Control Tower UI (frontend/app.py) ---
# Comma-separated origins allowed to call the API (CORS).
UI_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
# Comma-separated exact emails and/or "@domain.com" entries authorized
# to approve a cutover, AFTER Firebase verifies who they are. Empty/unset
# fails closed — nobody can approve until this is set explicitly.
APPROVER_ALLOWLIST=ops-lead@example.internal,@example.internal

# Emails granted the OPERATOR role — onboard estates, start assessments
# and runs, manage wave capacity. Without an entry here (or per-estate
# `estate_roles` custom claims) a real Google sign-in carries NO roles at
# all: every console read returns 403 and "Onboard estate" stays disabled.
# Same comma-separated form as APPROVER_ALLOWLIST; "@domain.com" matches a
# whole domain. Global and unscoped — a local/first-run bootstrap, meant to
# be emptied once custom claims are populated.
OPERATOR_ALLOWLIST=
# The Firebase project static/firebase-config.js's `projectId` names —
# usually NOT the same as GCP_PROJECT_ID above, since Firebase console's
# "Add project" flow creates its own project unless you explicitly
# import the existing GCP project. Required for server-side ID-token
# verification to succeed (frontend/app.py); falls back to GCP_PROJECT_ID
# only if unset, which is wrong for most setups and will 401 every login.
FIREBASE_PROJECT_ID=
# Optional for local end-user ADC. The E2E provisioning command defaults this
# to FIREBASE_PROJECT_ID automatically when it is otherwise unset.
# GOOGLE_CLOUD_QUOTA_PROJECT=autonomous-data-migration

# Optional dedicated Firebase Email/Password identity for browser E2E tests.
# Provision it with: python tools/provision_e2e_user.py --email you@domain.com
# The password is read from a no-echo prompt. For non-interactive automation,
# set CONTROL_TOWER_E2E_PASSWORD only in the process environment; do not save
# it in this file or pass it on the command line.
# CONTROL_TOWER_E2E_EMAIL=control-tower-e2e@your-domain.com
# CONTROL_TOWER_E2E_EMAIL_DOMAIN=your-domain.com

# --- In-process event consumers (Day 11 Phase 10) ------------------------
# The console publishes a durable Pub/Sub command for every operator
# action. These consume them inside the API process, so starting the
# server is the only command anyone runs — no per-click worker script.
#
# Default ON, which is the entire point. Set to 0 for a process that must
# serve the console only: the deployed container cannot run the workers
# today (it carries neither the Discovery fixtures nor the ODBC runtime),
# and CLI demos that drive the chain by hand want them off so `make run`
# and `make harness` are not racing an in-process consumer for the same
# message.
CONTROL_TOWER_WORKERS=1

# "all", or a comma-separated subset of:
#   assessment, migration, discovery, risk, plan, validation, recovery, cutover
# A name that matches nothing starts no consumers at all, and the console's
# Workers panel says so rather than idling silently.
CONTROL_TOWER_WORKER_CONSUMERS=all

# How long each pull blocks. Shutdown cannot finish until the in-flight
# pull returns, so this is also the worst-case restart delay.
CONTROL_TOWER_WORKER_POLL_SECONDS=20

# Cloud Billing export table, for the console's "Actual cost" panel.
# project.dataset.table — the table Cloud Billing creates when you enable
# Billing -> Billing export -> BigQuery export -> Standard usage cost.
#
# This is a BILLING ACCOUNT setting, not a project one, so
# infrastructure/gcp_setup.sh cannot provision it. Until it is set, the
# panel reports "not configured" rather than guessing. The export has no
# backfill: it accrues only from the moment you enable it.
#
# Snapshot it with: python -m tools.billing_export
CLOUD_BILLING_EXPORT_TABLE=

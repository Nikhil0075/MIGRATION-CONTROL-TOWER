{
  "name": "migration-control-tower-ui",
  "version": "2.0.0",
  "private": true,
  "description": "Oracle JET Redwood operator console for autonomous data migration",
  "scripts": {
    "build": "ojet build --release",
    "build:debug": "ojet build",
    "generate:api": "python ../../tools/export_openapi.py && openapi-typescript openapi.json -o src/generated/api-schema.ts",
    "serve": "ojet serve --server-port=8090",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "cross-env MCT_E2E_BYPASS=1 ojet build --release && playwright test",
    "test:e2e:update": "cross-env MCT_E2E_BYPASS=1 ojet build --release && playwright test --update-snapshots",
    "test:e2e:live": "playwright test --config=playwright.live.config.ts"
  },
  "dependencies": {
    "@oracle/oraclejet": "20.1.3",
    "@oracle/oraclejet-core-pack": "20.1.3",
    "firebase": "12.17.1",
    "openapi-fetch": "0.17.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@oracle/ojet-cli": "20.1.3",
    "@playwright/test": "^1.62.1",
    "@prefresh/babel-plugin": "0.5.3",
    "@prefresh/webpack": "4.0.6",
    "@testing-library/preact": "3.2.4",
    "@types/node": "18.16.3",
    "clean-webpack-plugin": "4.0.0",
    "compression-webpack-plugin": "12.0.0",
    "copy-webpack-plugin": "14.0.0",
    "cross-env": "^10.1.0",
    "css-fix-url-loader": "1.0.2",
    "css-loader": "7.1.4",
    "fs-extra": "8.1.0",
    "glob": "10.4.5",
    "html-replace-webpack-plugin": "2.6.0",
    "html-webpack-plugin": "5.6.8",
    "jsdom": "26.1.0",
    "mini-css-extract-plugin": "2.10.2",
    "noop-loader": "1.0.0",
    "openapi-typescript": "7.13.0",
    "raw-loader": "4.0.2",
    "sass": "1.102.0",
    "sass-loader": "17.0.0",
    "style-loader": "4.0.0",
    "ts-loader": "8.4.0",
    "typescript": "5.8.3",
    "underscore": "1.10.2",
    "vite": "6.4.1",
    "vitest": "2.1.9",
    "webpack": "5.101.0",
    "webpack-dev-server": "6.0.0",
    "webpack-merge": "6.0.1",
    "yargs-parser": "13.1.2"
  },
  "engines": {
    "node": ">=22 <23"
  },
  "overrides": {
    "@types/minimatch": "5.1.2",
    "vite": "6.4.1"
  }
}

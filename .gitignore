# Repo-root ignores.
#
# data-migration-control-tower/.gitignore covers everything inside the
# project. This file exists because `git init` is most naturally run HERE
# (the directory that contains the project, run_ui.py and the scratch
# simulator/ and tests/ trees), and a .gitignore only applies to its own
# directory and below — so anything at this level would otherwise be
# committed unprotected.

# Credentials. Belt-and-braces: the project's own .gitignore already
# covers its .env, but a root-level one would not be caught by it.
.env
.env.*
!.env.example
*.env
gcp-service-account*.json
*.pem
*.key

# Python
__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/
*.egg-info/

# Node
node_modules/

# Local tooling state
*.log
*.bak
